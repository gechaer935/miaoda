# Server
PORT=3001
BIND_ADDR=127.0.0.1
DATABASE_PATH=./data/miaoda.sqlite
MAX_UPLOAD_MB=3
MIAODA_JWT_SECRET=
# Value intentionally omitted.
TOKEN_TTL_HOURS=12
MIAODA_ADMIN_USERNAME=admin
MIAODA_ADMIN_TOKEN=
# Value intentionally omitted.
# Leave blank for public access protected by administrator username/password.
ADMIN_ALLOW_IPS=
ALLOW_ORIGIN=http://localhost:5173,http://localhost:5174
MOBILE_BASE_URL=http://localhost:5174
SUPPORT_EMAIL=
# Public support contacts shown on account pages.
SUPPORT_QQ=
SUPPORT_WECHAT=

# Optional feedback alerts. Configure either SMTP email, an HTTPS webhook,
# or both. Supported webhook types: generic, feishu, dingtalk, wecom.
FEEDBACK_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Value intentionally omitted.
SMTP_FROM=
FEEDBACK_NOTIFY_WEBHOOK=
FEEDBACK_NOTIFY_WEBHOOK_TYPE=generic

# Interview answer providers
DEEPSEEK_API_KEY=
# Value intentionally omitted.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=
# Value intentionally omitted.
BIGMODEL_API_KEY=
# Value intentionally omitted.
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
ANSWER_MODELS=deepseek:deepseek-v4-flash,deepseek:deepseek-v4-pro,aliyun:qwen3.7-plus

# DashScope realtime ASR and Aliyun models
DASHSCOPE_API_KEY=
# Value intentionally omitted.
# Optional: comma-separated keys from multiple DashScope accounts. The
# written solver rotates them and uses the next key when one request fails.
DASHSCOPE_API_KEYS=
# Value intentionally omitted.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Dedicated low-latency translation model. Translation requests stay on the
# server so the DashScope key is never distributed with the desktop client.
TRANSLATION_MODELS=aliyun:qwen-mt-lite
ALIYUN_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
ALIYUN_ASR_MODEL=fun-asr-realtime
ALIYUN_ASR_MAX_SENTENCE_SILENCE_MS=800

# Zhipu audio and vision
ZHIPU_AUDIO_BASE_URL=https://api.z.ai/api/paas/v4
ZHIPU_ASR_MODEL=glm-asr-2512
ZHIPU_VISION_MODELS=glm-4.6v-flashx
# Direct screenshot-to-answer route. Qwen3.7-Plus is the default;
# Qwen3.6-Plus is only used after all retries of the primary model fail.
WRITTEN_SOLVER_MODELS=aliyun:qwen3.7-plus,aliyun:qwen3.6-plus
# 1 means one retry after the initial request. With two keys, the retry uses
# the other key before falling back to the next model.
WRITTEN_SOLVER_RETRIES=1
# Abandon a stalled upstream attempt so another key/model can take over.
WRITTEN_SOLVER_ATTEMPT_TIMEOUT_SECONDS=60
# Thinking is enabled by default for written-test accuracy.
WRITTEN_SOLVER_THINKING=true

# Development only. Keep false for real end-to-end testing.
ALLOW_MODEL_MOCK=false
